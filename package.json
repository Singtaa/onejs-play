{
  "name": "onejs-play",
  "version": "0.5.5",
  "description": "Container runtime for OneJS Play. Imported as \"oj\".",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "build",
    "cli",
    "host"
  ],
  "keywords": [
    "onejs",
    "unity",
    "ui-toolkit",
    "react",
    "game",
    "webgl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Singtaa/onejs-play.git"
  },
  "author": "Singtaa",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "onejs-react": ">=0.1.50",
    "onejs-unity": ">=0.5.12",
    "react": "^18.0.0 || ^19.0.0",
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "onejs-react": "file:../onejs-react",
    "onejs-unity": "file:../onejs-unity",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "unity-types": "file:../unity-types",
    "vitest": "^2.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./container": "./src/container.ts",
    "./build/game": {
      "types": "./build/game.d.ts",
      "default": "./build/game.mjs"
    },
    "./build/externals.json": "./build/externals.json",
    "./cli/game": {
      "types": "./cli/game.d.ts",
      "default": "./cli/game.mjs"
    },
    "./host/boot": {
      "types": "./host/boot.d.ts",
      "default": "./host/boot.mjs"
    }
  },
  "bin": {
    "oj": "cli/oj.mjs"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  }
}
