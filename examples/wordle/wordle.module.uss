.tile {
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: rgb(58, 58, 60);
    border-radius: 4px;
}

.tileEmpty { border-color: rgb(58, 58, 60); }
.tileFilled { border-color: rgb(86, 87, 88); }

.correct {
    background-color: rgb(83, 141, 78);
    border-color: rgb(83, 141, 78);
}
.present {
    background-color: rgb(181, 159, 59);
    border-color: rgb(181, 159, 59);
}
.absent {
    background-color: rgb(58, 58, 60);
    border-color: rgb(58, 58, 60);
}

.key {
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background-color: rgb(129, 131, 132);
}
.keyWide { width: 62px; }
.keyNarrow { width: 40px; }
