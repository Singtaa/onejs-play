.well {
    border-width: 2px;
    border-color: rgb(60, 60, 66);
    background-color: rgb(18, 18, 20);
}

.cell {
    width: 24px;
    height: 24px;
    border-width: 1px;
    border-color: rgb(24, 24, 27);
    background-color: rgba(255, 255, 255, 0.02);
}

/* The preview sets size and spacing only, never a colour.
   The tone classes below set background-color and border-color, and at equal
   specificity whichever is written last would win. Sharing no property with
   them means the order of this file cannot decide how a piece looks, which is
   exactly the trap that left Vowel Play's keyboard untinted. */
.previewCell {
    width: 16px;
    height: 16px;
    margin: 1px;
}

.i { background-color: rgb(45, 194, 217); border-color: rgb(70, 214, 236); }
.o { background-color: rgb(224, 187, 46); border-color: rgb(240, 206, 78); }
.t { background-color: rgb(160, 82, 196); border-color: rgb(183, 110, 216); }
.s { background-color: rgb(74, 186, 92); border-color: rgb(102, 208, 120); }
.z { background-color: rgb(212, 66, 66); border-color: rgb(232, 96, 96); }
.j { background-color: rgb(56, 110, 210); border-color: rgb(84, 138, 232); }
.l { background-color: rgb(222, 128, 42); border-color: rgb(240, 154, 74); }
