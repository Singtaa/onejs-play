{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx",
        "types": [
            "unity-types",
            "react"
        ],
        "paths": {
            "oj": [
                "./node_modules/ojplay/src/index.ts"
            ]
        }
    },
    "include": [
        "**/*"
    ],
    "exclude": [
        "node_modules"
    ],
    "files": [
        ".oj/host.d.ts"
    ]
}
